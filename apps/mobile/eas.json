{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "10.28.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development" }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "channel": "e2e",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "e2e",
        "EXPO_PUBLIC_SUPABASE_URL": "http://10.0.2.2:54321"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
