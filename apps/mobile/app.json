{
  "expo": {
    "name": "Brazier",
    "slug": "brazier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brazier",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simpledesign.brazier",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.simpledesign.brazier"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070b10"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#ffb547"
        }
      ],
      "expo-font",
      "@sentry/react-native",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#070b10",
    "extra": {
      "eas": {
        "projectId": "d98a95e3-aea2-4024-a8cc-0fc797f92d6b"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "owner": "simple-design"
  }
}
